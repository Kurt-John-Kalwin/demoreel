# Required for any render
SOLARI_API_KEY=slr_live_...
# Planner: the Anthropic SDK is used when a key (or an `ant auth login` profile) exists;
# otherwise the `claude` CLI is used if installed; otherwise `demoreel init` cannot plan.
ANTHROPIC_API_KEY=
# Narration: ELEVENLABS_API_KEY is preferred when set, then OPENAI_API_KEY; without either, macOS `say` is
# used; tests use silence. DEMOREEL_TTS pins one adapter (elevenlabs | openai | say), DEMOREEL_TTS_MODEL and
# DEMOREEL_TTS_VOICE override the model and voice (ElevenLabs takes a voice id or a voice name on the account).
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEMOREEL_TTS=
DEMOREEL_TTS_MODEL=
DEMOREEL_TTS_VOICE=
# Public door guards (demoreel serve)
DEMOREEL_DAILY_BUDGET=200
DEMOREEL_PER_IP_DAILY=3
DEMOREEL_PAUSED=0
DEMOREEL_PORT=8787
DEMOREEL_DATA_DIR=./data
DEMOREEL_PUBLIC_URL=http://localhost:8787
